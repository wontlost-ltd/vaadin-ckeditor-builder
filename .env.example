# CKEditor License Key
# Get your license key from https://ckeditor.com/pricing
# Copy this file to .env and replace with your actual license key
CKEDITOR_LICENSE_KEY=your-license-key-here

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ================================
# Oracle ATP Configuration (Optional)
# ================================
# Set ORACLE_ENABLED=true to enable Oracle sync
ORACLE_ENABLED=false

# TNS alias from tnsnames.ora in wallet (e.g., ckeditoratp_low, ckeditoratp_medium)
ORACLE_TNS_ALIAS=ckeditoratp_low

# Path to Oracle wallet directory (extracted from wallet.zip)
# Download wallet from Oracle Cloud Console > ATP Instance > DB Connection
ORACLE_WALLET_PATH=./wallet

# Oracle database credentials (created in ATP instance)
ORACLE_USERNAME=ADMIN
ORACLE_PASSWORD=your-oracle-password

# Sync mode: REALTIME, SCHEDULED, MANUAL
# REALTIME: Sync immediately after each write
# SCHEDULED: Sync every 5 minutes
# MANUAL: Only sync when triggered manually
SYNC_MODE=REALTIME
